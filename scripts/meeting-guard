#!/usr/bin/env python3
"""
meeting-guard — an unmissable-enough meeting alert for macOS.

A launchd agent runs `meeting-guard poll` every 60s. It reads the next few hours
of the user's Google Calendar (via gcalcli) and escalates in two stages:

  T-5 min  heads-up : macOS notification. Soft, non-disruptive.
  T-2 min  banner   : a sticky bar across the menu bar, counting down, with
                      Dismiss and Snooze buttons. Never takes keyboard focus.

The banner is `meeting-banner` (Swift, alongside this file), compiled on demand
into ~/.local/state/meeting-guard/ because the binary is arch-specific and so
isn't committed. launchd can spawn it directly — verified — which is why there
is no longer any in-session helper.

History worth not repeating: this used to drive cmux, painting a full-screen red
takeover in a cmux workspace. launchd can't reach the cmux socket, so it needed a
trigger-file + heartbeat bridge to an in-session `watch` loop, self-healed from a
zsh precmd hook. All of that existed to work around cmux, and all of it is gone.
Under Claude Desktop the watcher was simply never alive, so every alert silently
degraded to the macOS modal fallback.

Subcommands:
  poll            Read calendar; notify / show the banner as due (what launchd runs).
  show            Run the banner for one meeting and record the outcome
                  (spawned detached by poll; not meant to be run by hand).
  test            Fabricate a meeting ~2 min out and show the banner NOW.
  agenda          Print what gcalcli currently returns (debug the calendar reader).
  install         Install + load the launchd agent.
  uninstall       Unload + remove the launchd agent.
  status          Show launchd + banner + config + recent log.

Design notes:
  - All state lives in ~/.config/meeting-guard/ ; logs in ~/.local/state/meeting-guard/.
  - Dedup is keyed per event so each meeting notifies once and banners once.
  - Snooze is the banner's exit code 10; `show` writes snooze_until and poll
    re-shows after it lapses.
  - If the mic is held open by anything, we're probably in a call and possibly
    screen-sharing, so the banner gets --hide-from-capture (sharingType = .none)
    and can't leak into that call.
"""

import json
import os
import shutil
import subprocess
import sys
from datetime import datetime, timedelta

HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(HOME, ".config", "meeting-guard")
STATE_PATH = os.path.join(CONFIG_DIR, "state.json")
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
LOG_DIR = os.path.join(HOME, ".local", "state", "meeting-guard")
LOG_PATH = os.path.join(LOG_DIR, "guard.log")

LABEL = "com.alexanderjeurissen.meeting-guard"
PLIST_PATH = os.path.join(HOME, "Library", "LaunchAgents", LABEL + ".plist")
SELF = os.path.realpath(__file__)

# the banner: source lives next to this script, binary is built on demand
BANNER_SRC = os.path.join(os.path.dirname(SELF), "meeting-banner.swift")
BANNER_BIN = os.path.join(LOG_DIR, "meeting-banner")

DEFAULTS = {
    # gcalcli reader. {start}/{end} are filled with ISO timestamps at call time.
    # --tsv gives tab-separated rows; --details=url appends the hangout/event link.
    "gcalcli_cmd": [
        "gcalcli", "--nocolor", "agenda", "--tsv", "--military",
        "--details=url", "--nodeclined", "{start}", "{end}",
    ],
    "soft_min": 5,    # the bar's span: full at T-soft, empty at meeting start
    "hard_min": 5,    # banner threshold. == soft_min, so the banner IS the
                      # heads-up and no separate notification fires. Set hard_min
                      # lower than soft_min to get a notification first.
    "lookahead_hours": 12,
    "max_duration_hours": 4,  # skip longer events: busy/focus blocks, not meetings
    "snooze_min": 1,  # minutes Snooze defers the banner for
    # how long past a meeting's start we keep re-showing a snoozed banner. Must
    # stay under the 3h state-prune horizon below or the event is forgotten first.
    "linger_min": 120,
    # assumed length when gcalcli gives us no end time, used for the banner's ttl
    "default_meeting_min": 30,
}


# ---------------------------------------------------------------------------
# small infra: config, state, logging, binaries
# ---------------------------------------------------------------------------

def ensure_dirs():
    os.makedirs(CONFIG_DIR, exist_ok=True)
    os.makedirs(LOG_DIR, exist_ok=True)


def load_config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG_PATH) as f:
            cfg.update(json.load(f))
    except FileNotFoundError:
        pass
    return cfg


def load_state():
    try:
        with open(STATE_PATH) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def save_state(state):
    ensure_dirs()
    tmp = STATE_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=2)
    os.replace(tmp, STATE_PATH)


def log(msg):
    ensure_dirs()
    stamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{stamp}] {msg}"
    try:
        with open(LOG_PATH, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass
    if sys.stderr.isatty():
        print(line, file=sys.stderr)


def which(name):
    return shutil.which(name) or shutil.which(
        name, path="/opt/homebrew/bin:/usr/local/bin:" + os.path.join(HOME, ".local/bin"))


def tool_env():
    """launchd's PATH is bare; make sure gcalcli / terminal-notifier resolve."""
    env = dict(os.environ)
    env["PATH"] = ":".join([
        "/opt/homebrew/bin", "/usr/local/bin",
        os.path.join(HOME, ".local/bin"), env.get("PATH", "/usr/bin:/bin"),
    ])
    return env


def notify(title, message, sound="Glass"):
    tn = which("terminal-notifier")
    if tn:
        subprocess.run(
            [tn, "-title", title, "-message", message, "-sound", sound,
             "-group", LABEL],
            env=tool_env(), capture_output=True, text=True,
        )


def beep():
    osa = which("osascript")
    if osa:
        subprocess.run([osa, "-e", "beep 2"], capture_output=True)


# ---------------------------------------------------------------------------
# the banner: build on demand, then run it
# ---------------------------------------------------------------------------

def _swiftc():
    for c in (shutil.which("swiftc"), "/usr/bin/swiftc",
              "/Library/Developer/CommandLineTools/usr/bin/swiftc"):
        if c and os.path.exists(c):
            return c
    try:
        r = subprocess.run(["/usr/bin/xcrun", "--find", "swiftc"],
                           capture_output=True, text=True, timeout=20)
        return r.stdout.strip() or None
    except (subprocess.SubprocessError, OSError):
        return None


def banner_bin():
    """Path to a built meeting-banner, compiling it if missing or stale.

    The binary is arch-specific, so it is deliberately not committed — it gets
    built into LOG_DIR the first time it's needed (and after any edit to the
    source). Returns None if it can't be built, so callers fall back to a modal.
    """
    if not os.path.exists(BANNER_SRC):
        log(f"banner source missing: {BANNER_SRC}")
        return None
    try:
        fresh = (os.path.exists(BANNER_BIN)
                 and os.path.getmtime(BANNER_BIN) >= os.path.getmtime(BANNER_SRC))
    except OSError:
        fresh = False
    if fresh:
        return BANNER_BIN
    sc = _swiftc()
    if not sc:
        log("swiftc not found — cannot build the banner")
        return None
    ensure_dirs()
    log(f"building banner: {sc} -O {BANNER_SRC} -o {BANNER_BIN}")
    try:
        r = subprocess.run([sc, "-O", BANNER_SRC, "-o", BANNER_BIN],
                           capture_output=True, text=True, timeout=180)
    except (subprocess.SubprocessError, OSError) as e:
        log(f"banner build errored: {e}")
        return None
    if r.returncode != 0:
        log(f"banner build failed rc={r.returncode}: {r.stderr.strip()[:300]}")
        return None
    return BANNER_BIN


def mic_hot():
    """True if anything holds an audio input stream open — i.e. we're in some
    call, and might be screen-sharing. Says nothing about WHICH meeting."""
    b = banner_bin()
    if not b:
        return False
    try:
        return subprocess.run([b, "mic"], capture_output=True,
                              text=True, timeout=15).returncode == 0
    except (subprocess.SubprocessError, OSError):
        return False


def banner_ttl(cfg, m):
    """Seconds the banner should live: until the meeting ends.

    Measured from now (the banner is spawned at T-soft, or later after a snooze),
    so it clears itself exactly when the meeting is over rather than piling up.

    Never returns <= 0: the banner treats 0 as "never expire", so a meeting whose
    end has already passed would produce an immortal banner. Floors at grace_sec
    so a late re-show is still dismissable, and falls back to a nominal duration
    when gcalcli gave us no end time.
    """
    grace = 60
    end = m.get("end")
    if not end:
        end = m["start"] + timedelta(minutes=cfg["default_meeting_min"])
    return max(grace, int((end - datetime.now()).total_seconds()))


def show_banner(cfg, m, key=None):
    """Spawn `show` detached so poll stays fast and the 60s tick isn't blocked."""
    ensure_dirs()
    argv = [SELF, "show",
            "--title", str(m["title"]),
            "--start", m["start"].isoformat(timespec="seconds"),
            "--window", str(int(cfg["soft_min"]) * 60),
            "--ttl", str(banner_ttl(cfg, m))]
    if key:
        argv += ["--key", key]
    try:
        subprocess.Popen(argv, env=tool_env(),
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        return True
    except (subprocess.SubprocessError, OSError) as e:
        log(f"could not spawn banner: {e}")
        modal_fallback(m)
        return False


def cmd_show(cfg, args):
    """Run the banner synchronously and record what the user chose.

    Separate subcommand (rather than inline in poll) so poll can fire and forget:
    the banner lives for up to its TTL, which is longer than the launchd interval.
    """
    title = _argval(args, "--title", "(meeting)")
    start_iso = _argval(args, "--start", "")
    key = _argval(args, "--key", "")
    window = _argval(args, "--window", str(int(cfg["soft_min"]) * 60))
    ttl = _argval(args, "--ttl", "")
    try:
        start = datetime.fromisoformat(start_iso) if start_iso else datetime.now()
    except ValueError:
        start = datetime.now()

    b = banner_bin()
    if not b:
        log("no banner binary — falling back to the macOS modal")
        modal_fallback({"title": title, "start": start})
        return

    argv = [b, "--title", title, "--start", start.isoformat(timespec="seconds"),
            "--window", window]
    if ttl:
        argv += ["--ttl", ttl]
    # in a call => possibly sharing a screen; keep the banner out of the capture
    if mic_hot():
        argv.append("--hide-from-capture")
        log(f"mic hot — banner hidden from screen capture for '{title}'")
    beep()
    try:
        rc = subprocess.run(argv, env=tool_env()).returncode
    except (subprocess.SubprocessError, OSError) as e:
        log(f"banner failed to run: {e}")
        modal_fallback({"title": title, "start": start})
        return

    state = load_state()
    st = state.setdefault(key or event_key({"start": start, "title": title}), {})
    if rc == 10:
        st["snooze_until"] = (
            datetime.now() + timedelta(minutes=cfg["snooze_min"])).isoformat()
        log(f"snoozed '{title}' for {cfg['snooze_min']} min")
    else:
        st["acked"] = datetime.now().isoformat()
        st.pop("snooze_until", None)
        log(f"{'dismissed' if rc == 0 else f'banner exited rc={rc};'} '{title}'")
    save_state(state)


def modal_fallback(m):
    """Last resort when the banner can't run at all: a critical, front-floating
    macOS alert that blocks until clicked."""
    osa = which("osascript")
    if not osa:
        log("osascript missing — no fallback alert available")
        return
    start = m["start"] if isinstance(m["start"], datetime) else datetime.now()
    title = str(m["title"]).replace('"', "'")
    body = f"{title}\\nStarts {start.strftime('%H:%M')}"
    subprocess.run(
        [osa, "-e", "beep 3", "-e",
         f'display alert "MEETING STARTING" message "{body}" '
         'as critical buttons {"Dismiss"} default button "Dismiss"'],
        capture_output=True,
    )


def _argval(args, flag, default=""):
    if flag in args:
        i = args.index(flag)
        if i + 1 < len(args):
            return args[i + 1]
    return default


def read_meetings(cfg):
    """Return a list of dicts {start: datetime(local), title, url} for upcoming events."""
    gcal = which("gcalcli")
    if not gcal:
        log("gcalcli not installed/authenticated yet — no meetings read.")
        return load_agenda_cache(cfg, "gcalcli missing")

    now = datetime.now()
    end = now + timedelta(hours=cfg["lookahead_hours"])
    start_s = now.strftime("%Y-%m-%dT%H:%M")
    end_s = end.strftime("%Y-%m-%dT%H:%M")

    cmd = [gcal if a == "gcalcli" else a.format(start=start_s, end=end_s)
           for a in cfg["gcalcli_cmd"]]
    try:
        out = subprocess.run(
            cmd, env=tool_env(), capture_output=True, text=True, timeout=30
        )
    except (subprocess.SubprocessError, OSError) as e:
        log(f"gcalcli failed: {e}")
        return load_agenda_cache(cfg, "gcalcli error")

    if out.returncode != 0:
        log(f"gcalcli rc={out.returncode}: {out.stderr.strip()[:200]}")
        return load_agenda_cache(cfg, f"gcalcli rc={out.returncode}")

    meetings = []
    for raw in out.stdout.splitlines():
        line = raw.rstrip("\n")
        if not line.strip():
            continue
        fields = line.split("\t")
        if len(fields) < 3:
            continue
        sdate, stime = fields[0].strip(), fields[1].strip()
        if not stime:  # all-day event -> empty start time; skip per scope
            continue
        try:
            start = datetime.strptime(f"{sdate} {stime}", "%Y-%m-%d %H:%M")
        except ValueError:
            continue
        # end (for duration): tsv cols 3,4 are end_date, end_time
        end = None
        if len(fields) >= 4 and fields[3].strip():
            try:
                end = datetime.strptime(
                    f"{fields[2].strip()} {fields[3].strip()}", "%Y-%m-%d %H:%M")
            except ValueError:
                end = None
        # skip multi-hour "busy"/focus blocks ("Don't book without asking!" etc.)
        if end and (end - start) > timedelta(hours=cfg["max_duration_hours"]):
            continue
        # prefer a real join link (Meet/Zoom) over the generic event page
        links = [f.strip() for f in fields if f.strip().startswith("http")]
        url = next((u for u in links
                    if any(h in u for h in ("meet.google", "zoom.", "hangout"))),
                   links[0] if links else "")
        title = ""
        # title is the last non-url, non-time field
        for f in reversed(fields[2:]):
            f = f.strip()
            if f and not f.startswith("http") and not _looks_like_dt(f):
                title = f
                break
        meetings.append({"start": start, "end": end,
                         "title": title or "(untitled meeting)", "url": url})
    save_agenda_cache(meetings)
    return meetings


AGENDA_CACHE_PATH = os.path.join(CONFIG_DIR, "agenda_cache.json")


def _parse_dt(s):
    """Parse a cached ISO timestamp, tolerating a corrupt entry.

    Defined here next to its only callers. It previously lived far down the file
    among the CLI subcommands; the cmux-removal rewrite carried over the calendar
    reader without it, so every cache fallback raised NameError and took the whole
    poll down instead of degrading to the cached agenda.
    """
    try:
        return datetime.fromisoformat(s)
    except (ValueError, TypeError):
        return datetime.now()


def save_agenda_cache(meetings):
    """Persist the last good agenda so a flaky gcalcli read doesn't blind a poll."""
    ensure_dirs()
    payload = {
        "ts": datetime.now().isoformat(),
        "meetings": [{"start": m["start"].isoformat(),
                      "end": m["end"].isoformat() if m.get("end") else None,
                      "title": m["title"],
                      "url": m.get("url", "")} for m in meetings],
    }
    tmp = AGENDA_CACHE_PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(payload, f)
    os.replace(tmp, AGENDA_CACHE_PATH)


def load_agenda_cache(cfg, reason):
    """Fall back to the last good agenda when gcalcli fails, if recent enough.

    The calendar barely changes minute-to-minute, so reusing a recent read is
    far safer than returning [] (which would silently skip an imminent meeting).
    """
    try:
        with open(AGENDA_CACHE_PATH) as f:
            data = json.load(f)
        age = (datetime.now() - datetime.fromisoformat(data["ts"])).total_seconds()
    except (OSError, ValueError, KeyError):
        log(f"{reason}; no usable agenda cache — returning no meetings")
        return []
    max_age = cfg.get("cache_max_age_hours", 3) * 3600
    if age > max_age:
        log(f"{reason}; agenda cache too old ({age/3600:.1f}h) — returning no meetings")
        return []
    meetings = [{"start": _parse_dt(m["start"]),
                 "end": _parse_dt(m["end"]) if m.get("end") else None,
                 "title": m["title"], "url": m.get("url", "")}
                for m in data.get("meetings", [])]
    log(f"{reason}; using cached agenda ({age/60:.0f}m old, {len(meetings)} events)")
    return meetings


def _looks_like_dt(s):
    for fmt in ("%Y-%m-%d", "%H:%M"):
        try:
            datetime.strptime(s, fmt)
            return True
        except ValueError:
            pass
    return False


def event_key(m):
    return m["start"].strftime("%Y%m%dT%H%M") + "|" + m["title"][:60]


# ---------------------------------------------------------------------------
# poll: decide + fire
# ---------------------------------------------------------------------------

def cmd_poll(cfg):
    state = load_state()
    now = datetime.now()
    meetings = read_meetings(cfg)

    # prune state for events now well in the past
    for k in list(state):
        try:
            kt = datetime.strptime(k.split("|")[0], "%Y%m%dT%H%M")
        except ValueError:
            continue
        if now - kt > timedelta(hours=3):
            del state[k]

    for m in meetings:
        mins = (m["start"] - now).total_seconds() / 60.0
        # Keep considering an event well past its start time. A banner is meant to
        # persist until Dismiss or Snooze, and a snooze taken during an
        # already-running meeting has to come back — with the old `mins < -1`
        # bound the event was already out of range by then, so it never did.
        if mins > cfg["soft_min"] or mins < -cfg["linger_min"]:
            continue
        # once the meeting is over there is nothing left to nag about; linger_min
        # is only the bound for events whose end time we could not read
        if m.get("end") and now > m["end"]:
            continue
        key = event_key(m)
        st = state.setdefault(key, {})

        # heads-up window: (hard, soft]
        if cfg["hard_min"] < mins <= cfg["soft_min"] and not st.get("headsup"):
            st["headsup"] = now.isoformat()
            log(f"heads-up: '{m['title']}' in {mins:.1f} min")
            notify(f"Meeting in {int(round(mins))} min", m["title"])

        # banner window: <= hard, until meeting start (+grace)
        if mins <= cfg["hard_min"]:
            snooze_until = st.get("snooze_until")
            if snooze_until and datetime.fromisoformat(snooze_until) > now:
                continue
            if st.get("shown") and not st.get("snooze_until"):
                continue  # already banner'd once and wasn't snoozed
            st["shown"] = now.isoformat()
            st.pop("snooze_until", None)
            log(f"BANNER: '{m['title']}' in {mins:.1f} min")
            show_banner(cfg, m, key)

    save_state(state)


# ---------------------------------------------------------------------------
# test / agenda / install / status
# ---------------------------------------------------------------------------

def cmd_test(cfg):
    print("Showing the banner for a fake meeting starting in ~2 minutes...")
    print("Look at the top of the screen: a bar over the menu bar, counting down.")
    b = banner_bin()
    print(f"banner binary: {b or 'COULD NOT BUILD'}")
    m = {"start": datetime.now() + timedelta(minutes=2),
         "end": datetime.now() + timedelta(minutes=5),
         "title": "TEST - meeting-guard banner demo"}
    show_banner(cfg, m)


def cmd_agenda(cfg):
    meetings = read_meetings(cfg)
    if not meetings:
        print("No meetings read (gcalcli not authed yet, or none upcoming).")
        return
    now = datetime.now()
    for m in meetings:
        mins = (m["start"] - now).total_seconds() / 60.0
        print(f"  {m['start']:%a %H:%M}  (in {mins:6.1f} min)  {m['title']}"
              + (f"  [{m['url']}]" if m["url"] else ""))


def cmd_install():
    ensure_dirs()
    # build eagerly so a first real meeting isn't waiting on swiftc
    print(f"banner: {banner_bin() or 'COULD NOT BUILD (will retry at poll time)'}")
    plist = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{LABEL}</string>
    <key>ProgramArguments</key>
    <array>
        <string>{SELF}</string>
        <string>poll</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:{os.path.join(HOME, ".local/bin")}:/usr/bin:/bin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>{os.path.join(LOG_DIR, "launchd.out.log")}</string>
    <key>StandardErrorPath</key>
    <string>{os.path.join(LOG_DIR, "launchd.err.log")}</string>
</dict>
</plist>
"""
    with open(PLIST_PATH, "w") as f:
        f.write(plist)
    subprocess.run(["launchctl", "unload", PLIST_PATH], capture_output=True)
    r = subprocess.run(["launchctl", "load", PLIST_PATH], capture_output=True, text=True)
    if r.returncode != 0:
        print("launchctl load failed:", r.stderr.strip())
        return
    print(f"Installed + loaded {LABEL} (polls every 60s).")
    print(f"  plist: {PLIST_PATH}")
    print(f"  logs:  {LOG_PATH}")


def cmd_uninstall():
    subprocess.run(["launchctl", "unload", PLIST_PATH], capture_output=True)
    try:
        os.remove(PLIST_PATH)
    except FileNotFoundError:
        pass
    print(f"Unloaded + removed {LABEL}.")


def cmd_status(cfg):
    print("== meeting-guard status ==")
    print(f"self:    {SELF}")
    print(f"gcalcli: {which('gcalcli') or 'NOT INSTALLED'}")
    print(f"swiftc:  {_swiftc() or 'NOT FOUND'}")
    print(f"src:     {BANNER_SRC}  "
          f"({'present' if os.path.exists(BANNER_SRC) else 'MISSING'})")
    banner_bin()          # build first, so the line below reports the real state
    built = os.path.exists(BANNER_BIN)
    stale = ""
    if built and os.path.exists(BANNER_SRC):
        stale = "" if os.path.getmtime(BANNER_BIN) >= os.path.getmtime(BANNER_SRC) \
            else "  (STALE — will rebuild)"
    print(f"banner:  {BANNER_BIN}  ({'built' if built else 'not built yet'}){stale}")
    print(f"plist:   {PLIST_PATH}  "
          f"({'present' if os.path.exists(PLIST_PATH) else 'not installed'})")
    r = subprocess.run(["launchctl", "list"], capture_output=True, text=True)
    print(f"loaded:  {LABEL in r.stdout}")
    print(f"mic:     {'hot (banner would hide from capture)' if mic_hot() else 'idle'}")
    print(f"thresholds: heads-up T-{cfg['soft_min']}m, banner T-{cfg['hard_min']}m")
    if os.path.exists(LOG_PATH):
        print("\n-- last log lines --")
        with open(LOG_PATH) as f:
            for line in f.readlines()[-8:]:
                print("  " + line.rstrip())


def main():
    ensure_dirs()
    cfg = load_config()
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    rest = sys.argv[2:]
    if cmd == "poll":
        cmd_poll(cfg)
    elif cmd == "show":
        cmd_show(cfg, rest)
    elif cmd == "test":
        cmd_test(cfg)
    elif cmd == "agenda":
        cmd_agenda(cfg)
    elif cmd == "install":
        cmd_install()
    elif cmd == "uninstall":
        cmd_uninstall()
    elif cmd in ("status", "-h", "--help", "help"):
        cmd_status(cfg)
    else:
        print(f"unknown command: {cmd}", file=sys.stderr)
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
